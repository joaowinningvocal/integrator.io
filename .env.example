# Senha do console. Obrigatória — sem ela o login não funciona.
ADMIN_PASSWORD=troque-isto

# Chave de sessão do Flask. Gere uma: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-isto-tambem

# Onde o SQLite vive. No Railway, monte um volume em /data.
# Se este caminho não for gravável, o app agora FALHA no boot em vez de cair
# para um diretório efêmero e perder o banco no próximo restart.
DATA_DIR=/data

# Torna os tokens dos webhooks estáveis. Sem isso eles são aleatórios e mudam
# se o banco for recriado, fazendo as URLs já coladas no Agni darem 401.
# Gere um: python -c "import secrets;print(secrets.token_urlsafe(32))"
HOOK_TOKEN_SALT=troque-isto-e-nunca-mude

# Usado só pra montar a URL do webhook exibida na tela de venues.
PUBLIC_BASE_URL=https://integrator-io.up.railway.app
